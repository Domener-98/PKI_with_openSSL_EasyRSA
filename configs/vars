# Easy-RSA parameters used in the project
# Copy into ~/projetPKI/easy-RSA/vars (based on /etc/easy-rsa/vars.example)

set_var EASYRSA_REQ_COUNTRY  "BE"
set_var EASYRSA_REQ_PROVINCE "Bruxelles"
set_var EASYRSA_REQ_CITY     "Bruxelles"
set_var EASYRSA_REQ_ORG      "PKI-ITSCM"
set_var EASYRSA_REQ_EMAIL    "admin@example.com"
set_var EASYRSA_REQ_OU       "PKI-ITSCM"

# 4096-bit RSA key, CA valid for 10 years
set_var EASYRSA_KEY_SIZE     4096
set_var EASYRSA_CA_EXPIRE    3650
